# ASURA Defense Intelligence System — Environment Variables
# Copy to .env.local and fill in your keys. NEVER commit .env.local.

# ── AI Gateway (required) ──
GROQ_API_KEY=

# ── Search & Discovery (recommended) ──
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── News / OSINT (recommended) ──
NEWSAPI_KEY=

# ── Geospatial (recommended) ──
CESIUM_ION_ACCESS_TOKEN=

# ── Aviation (recommended) ──
AVIATIONSTACK_API_KEY=

# ── Weather (recommended) ──
OPENWEATHERMAP_API_KEY=

# ── Application ──
JWT_SECRET=
NEXT_PUBLIC_APP_NAME=ASURA
