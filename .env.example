# ASURA Defense Intelligence System — Environment Variables
# Copy to .env.local and fill in your keys. NEVER commit .env.local.

# ── AI Gateway (required) ──
GROQ_API_KEY=
# Optional: auto uses Muse Spark 816B if entitled, else Groq Qwen 3.8 27B
# for image questions (real model disclosed in UI). preview-only restricts
# image analysis to Muse Spark Open 816B and fails closed if unavailable.
# Text questions remain on GPT-OSS 120B regardless of this setting.
ASURA_VISION_POLICY=auto

# ── Search & Discovery (recommended) ──
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── News / OSINT (recommended) ──
NEWSAPI_KEY=

# ── Geospatial (recommended) ──
CESIUM_ION_ACCESS_TOKEN=
# Public Cesium viewer token only: assets:read, domain restrict to asura-topaz.vercel.app.
# Never copy privileged/default ion tokens into this public key.
CESIUM_ION_PUBLIC_TOKEN=

# ── Aviation (recommended) ──
AVIATIONSTACK_API_KEY=

# Optional FlightAware AeroAPI (metered). Only enable public display if your
# FlightAware contract explicitly permits public or commercial redistribution.
# The website is never scraped. ASURA keeps this data separate from ADS-B feeds.
FLIGHTAWARE_AEROAPI_KEY=
FLIGHTAWARE_PUBLIC_DISPLAY_LICENSED=false
# Set true ONLY when your written agreement explicitly allows this intended
# ASURA use, including aircraft situational display (if applicable) and any
# combination of FlightAware with ADS-B or other real-time providers.
# The standard AeroAPI agreement prohibits some of these uses by default.
FLIGHTAWARE_OPERATIONAL_USE_AUTHORIZED=false

# ── Weather (recommended) ──
OPENWEATHERMAP_API_KEY=

# ── Nasdaq Trader RSS (OPTIONAL, disabled by default) ──
# Do not enable without reviewing and accepting Nasdaq's current RSS terms.
# See https://www.nasdaqtrader.com/Trader.aspx?id=TradeHaltRSS
# The feed is not licensed streaming price data or an operational market feed.
NASDAQ_HALTS_TERMS_ACCEPTED=false

# ── Additional official public connectors ──
# NASA DEMO_KEY used if NASA_API_KEY empty; shared public quota.
NASA_API_KEY=
# DVIDS requires authorized API application credentials.
DVIDS_API_KEY=
# Set true ONLY after written IMF reuse rights for this application are recorded.
IMF_PORTWATCH_REUSE_AUTHORIZED=false

# ── Application ──
JWT_SECRET=
NEXT_PUBLIC_APP_NAME=ASURA

# ── Authorized public cameras ──
# Caltrans CWWP2 is public and requires no key.
# Windy Webcams V3: obtain the specific Webcams API key (NOT Windy Forecast key).
# Free plan permits linked images and embedded players subject to Windy terms.
WINDY_WEBCAMS_API_KEY=
