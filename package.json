{
  "name": "asura",
  "version": "0.1.0",
  "private": true,
  "description": "ASURA Defense Intelligence System™",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "validate-keys": "node scripts/validate-keys.js",
    "test:operational": "node --test tests/operationalFeeds.test.cjs tests/expandedFeeds.test.cjs tests/wave2Feeds.test.cjs tests/wave3Feeds.test.cjs",
    "test:vision": "node --test tests/visionRouting.test.cjs",
    "test:news": "node --test tests/newsRouting.test.cjs tests/quotaHandling.test.cjs",
    "test:red-team": "node --test tests/redTeamReadOnly.test.cjs tests/defenceValidationEngine.test.cjs",
    "test:blue-team": "node --test tests/blueTeamEngine.test.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.8.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
